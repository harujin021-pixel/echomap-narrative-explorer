# ============================================================
# EchoMap 环境变量模板
# ------------------------------------------------------------
# 用法：将本文件复制为 .env，再填入真实值。
# .env 已被 .gitignore 排除，不会被提交到版本库。
# 严禁把真实密钥写进本模板文件或提交到 Git。
# ============================================================

# --- 本地模型配置（阶段 5：文案生成；默认 mock，无需配置即可运行）---
# 注意：程序从【进程环境变量】读取（当前项目未启用 .env 自动加载），
#       请在启动前设置，例如 PowerShell：
#         $env:ECHOMAP_LLM_PROVIDER="ollama"; $env:ECHOMAP_OLLAMA_MODEL="qwen3:1.7b"
# 后端选择："mock"（默认，占位文案，不发请求）、"ollama"（本机 127.0.0.1:11434）
#           或 "gemini"（Google 在线接口，免费额度；供云端部署使用）
# ECHOMAP_LLM_PROVIDER=mock
# ollama 模式必填：本机已下载的模型名（如 qwen3:1.7b）
# ECHOMAP_OLLAMA_MODEL=
# 以下为可选覆盖项（留空使用默认值）
# ECHOMAP_OLLAMA_HOST=http://127.0.0.1:11434
# ECHOMAP_OLLAMA_TIMEOUT=180

# --- Gemini 在线后端（gemini 模式必填密钥；密钥严禁写入代码或提交到 Git）---
# 密钥也可放在部署平台的 Secrets 中（Streamlit Community Cloud 的 Secrets）
# ECHOMAP_GEMINI_API_KEY=
# 可选：模型名（留空使用默认 gemini-2.0-flash）
# ECHOMAP_GEMINI_MODEL=
# 可选：单次生成超时秒数（默认 60）
# ECHOMAP_GEMINI_TIMEOUT=60

# --- Groq 在线后端（groq 模式必填密钥；与 Gemini 互为备选，额度用尽可切换）---
# ECHOMAP_GROQ_API_KEY=
# 可选：模型名（留空使用默认 llama-3.3-70b-versatile）
# ECHOMAP_GROQ_MODEL=
# 可选：单次生成超时秒数（默认 60）
# ECHOMAP_GROQ_TIMEOUT=60

# --- 数据来源配置（阶段 1 起可能使用；本项目不使用付费 API）---
# NEWS_API_KEY=
# NEWS_API_BASE_URL=

# --- 本地路径配置（可选，留空则使用默认路径）---
# ECHOMAP_RAW_DATA_DIR=data/raw
# ECHOMAP_PROCESSED_DATA_DIR=data/processed
