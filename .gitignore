# ============================================================
# EchoMap .gitignore
# 目标：确保真实新闻数据、密钥和个人文件不会被误提交
# ============================================================

# --- Python 缓存与虚拟环境 ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.venv/
venv/
env/

# --- 测试 / 覆盖率缓存 ---
.pytest_cache/
.mypy_cache/
.tox/
htmlcov/
.coverage
.coverage.*
coverage.xml

# --- 本地临时文件 ---
*.tmp
*.temp
*.bak
*.swp
*.swo
*~
.cache/

# --- 环境变量与密钥（禁止提交）---
.env
.env.*
!.env.example
*.key
*.pem
.streamlit/secrets.toml

# --- 真实新闻数据（禁止提交，仅保留占位文件）---
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
reports/*
!reports/.gitkeep
# 常见数据文件类型一并忽略，避免误提交
*.csv
*.tsv
*.xlsx
*.json
# 例外：明确标记为合成数据的测试样本允许提交（位于 tests/fixtures/）
!tests/fixtures/*.csv
# 例外：数据准备模板（data/templates/，合成示例记录，见 docs/DATA_PREPARATION.md）
!data/templates/*.csv

# --- 编辑器 / 系统文件 ---
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# --- 日志 ---
*.log
